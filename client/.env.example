# Safe Passage Frontend Environment Variables
# -------------------------------------------------------------
# LOCAL DEVELOPMENT (default)
# Copy to .env for local testing:
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
#
# PRODUCTION DEPLOYMENT (Vercel Project Settings)
# Add these under: Vercel Dashboard -> Project Settings -> Environment Variables
# Replace with your deployed cloud backend URL (e.g. from Render or Railway):
# VITE_API_URL=https://safe-passage-api.onrender.com/api
# VITE_SOCKET_URL=https://safe-passage-api.onrender.com

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
